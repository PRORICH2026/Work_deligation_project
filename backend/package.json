{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --config prisma7.config.ts && tsc",
    "start": "node dist/src/index.js",
    "migrate:deploy": "prisma migrate deploy --config prisma.baseline.config.ts",
    "migrate:status": "prisma migrate status --config prisma.baseline.config.ts",
    "migrate:dev": "prisma migrate dev --config prisma.baseline.config.ts",
    "migrate:verify": "node scripts/verify-migrations.cjs",
    "test": "node --test tests/*.test.cjs",
    "seed:departments": "tsx src/scripts/seedDepartments.ts",
    "seed:users": "tsx src/scripts/seedUsers.ts",
    "seed:employees": "tsx src/scripts/seedEmployees.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
