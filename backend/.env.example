NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/delegation_management
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Explicit migration target, separate from the runtime/local database URL.
# Set this only for a fresh database or a database already using the baseline.
# MIGRATION_DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/NEW_DATABASE
# Only needed when authoring future migrations on a separate development DB:
# MIGRATION_SHADOW_DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/SHADOW_DATABASE
